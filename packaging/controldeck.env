# ControlDeck configuration, read by controldeck.service.
# Apply changes with: systemctl restart controldeck

# Listen address. There is no authentication: keep it on localhost or put a
# reverse proxy with auth in front before exposing it.
DECK_ADDR=127.0.0.1:8080

# Sampling interval in seconds.
#DECK_INTERVAL_SECS=5

# SQLite file (the service sets /var/lib/controldeck/metrics.db by default).
#DECK_DB=/var/lib/controldeck/metrics.db
