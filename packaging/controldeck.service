[Unit]
Description=ControlDeck server management control panel (web, unprivileged)
Documentation=https://github.com/banshee-lab/controldeck
After=network.target controldeck-agent.service
# The dashboard works without the agent; only package management needs it.
Wants=controldeck-agent.service

[Service]
Type=simple
ExecStart=/usr/bin/controldeck
# Defaults; override in /etc/controldeck/controldeck.env
Environment=DECK_DB=/var/lib/controldeck/metrics.db
EnvironmentFile=-/etc/controldeck/controldeck.env
# Static account (created by the package): the privileged agent only accepts
# connections from this user. Do not run anything else as it.
User=controldeck
Group=controldeck
StateDirectory=controldeck
Restart=on-failure
RestartSec=3

# Hardening (kept compatible with reading /proc and statvfs on all mounts)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RemoveIPC=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
