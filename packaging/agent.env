# ControlDeck privileged agent configuration, read by controldeck-agent.service.
# Root-only file. Apply changes with: systemctl restart controldeck-agent

# Unix socket the web server connects to (must match controldeck.env).
#DECK_AGENT_SOCKET=/run/controldeck/agent.sock

# The only account allowed to connect; must match User= in controldeck.service.
#DECK_AGENT_USER=controldeck

# Also require the connecting process to run this executable, so other
# processes that happen to share the account are refused. Unset to disable.
DECK_AGENT_PEER_EXE=/usr/bin/controldeck

# --- "packages" plugin ---
# Force a package manager (apt, dnf, zypper, pacman, emerge, apk).
#DECK_PKG_MANAGER=apt
# 1 disables every package-modifying operation.
#DECK_PKG_READONLY=1
